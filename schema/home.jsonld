      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#climatizacion",
      "name": "Climatización",
      "alternateName": [
        "HVAC",
        "Aire acondicionado"
      ],
      "description": "Conjunto de técnicas e instalaciones que controlan la temperatura, la humedad y la calidad del aire de un espacio para mantener condiciones de confort.",
      "url": "https://conductosergui.es/glosario#climatizacion",
      "inDefinedTermSet": {
        "@id": "https://conductosergui.es/glosario#terminos"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#conducto-de-aire",
      "name": "Conducto de aire",
      "alternateName": [
        "Conductos de climatización",
        "Red de conductos"
      ],
      "description": "Canalización que transporta el aire tratado desde el equipo hasta las rejillas y difusores, y lo devuelve por el retorno. Se fabrica habitualmente en panel de lana de vidrio o en chapa de acero galvanizado.",
      "url": "https://conductosergui.es/glosario#conducto-de-aire",
      "inDefinedTermSet": {
        "@id": "https://conductosergui.es/glosario#terminos"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#ventilacion",
      "name": "Ventilación",
      "alternateName": [
        "Renovación de aire",
        "Ventilación forzada"
      ],
      "description": "Renovación del aire interior de un espacio mediante su intercambio con aire exterior, de forma natural o mecánica, para mantener la calidad del aire.",
      "url": "https://conductosergui.es/glosario#ventilacion",
      "inDefinedTermSet": {
        "@id": "https://conductosergui.es/glosario#terminos"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#extraccion-de-humos",
      "name": "Extracción de humos",
      "description": "Evacuación mecánica al exterior de los humos, vapores y grasas generados en cocinas u otros procesos, mediante campana, conducto y ventilador.",
      "url": "https://conductosergui.es/glosario#extraccion-de-humos",
      "inDefinedTermSet": {
        "@id": "https://conductosergui.es/glosario#terminos"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#placa-de-yeso-laminado",
      "name": "Placa de yeso laminado",
      "alternateName": [
        "PYL",
        "Pladur"
      ],
      "description": "Placa de núcleo de yeso revestida con láminas de cartón, base de los sistemas de tabiquería, trasdosados y techos en seco. «Pladur» es el nombre comercial con el que se conoce de forma habitual.",
      "url": "https://conductosergui.es/glosario#placa-de-yeso-laminado",
      "inDefinedTermSet": {
        "@id": "https://conductosergui.es/glosario#terminos"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#aislamiento-termico",
      "name": "Aislamiento térmico",
      "description": "Capacidad de un material o sistema constructivo para reducir la transmisión de calor entre dos ambientes; en la edificación limita las pérdidas en invierno y las ganancias en verano.",
      "url": "https://conductosergui.es/glosario#aislamiento-termico",
      "inDefinedTermSet": {
        "@id": "https://conductosergui.es/glosario#terminos"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://conductosergui.es/glosario#aislamiento-acustico",
      "name": "Aislamiento acústico",
      "description": "Conjunto de soluciones que reducen la transmisión del sonido entre recintos o desde el exterior; en construcción en seco combina placas, cámaras de aire y material absorbente.",
